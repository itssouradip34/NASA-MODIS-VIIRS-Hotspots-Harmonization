# Pyro-Harmony Configuration
# Note: NASA FIRMS open public NRT streams work out-of-the-box without an API key!
# If you have a custom NASA FIRMS MAP_KEY from earthdata, you can optionally set it here:
FIRMS_MAP_KEY=
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development
DATA_CACHE_DIR=data/raw
PROCESSED_DIR=data/processed
MODELS_DIR=models
